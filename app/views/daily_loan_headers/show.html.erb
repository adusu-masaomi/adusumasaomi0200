<%- model_class = DailyLoanHeader -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="dl-horizontal">
  <dt><strong><%= model_class.human_attribute_name(:occurred_on) %>:</strong></dt>
  <dd><%= @daily_loan_header.occurred_on %></dd>
  <dt><strong><%= model_class.human_attribute_name(:lend) %>:</strong></dt>
  <dd><%= @daily_loan_header.lend %></dd>
  <dt><strong><%= model_class.human_attribute_name(:borrow) %>:</strong></dt>
  <dd><%= @daily_loan_header.borrow %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              daily_loan_headers_path, :class => 'btn btn-default'  %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_daily_loan_header_path(@daily_loan_header), :class => 'btn btn-default' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              daily_loan_header_path(@daily_loan_header),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
