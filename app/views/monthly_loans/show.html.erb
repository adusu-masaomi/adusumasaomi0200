<%- model_class = MonthlyLoan -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="dl-horizontal">
  <dt><strong><%= model_class.human_attribute_name(:occur_year_month) %>:</strong></dt>
  <dd><%= @monthly_loan.occur_year_month %></dd>
  <dt><strong><%= model_class.human_attribute_name(:lend) %>:</strong></dt>
  <dd><%= @monthly_loan.lend %></dd>
  <dt><strong><%= model_class.human_attribute_name(:borrow) %>:</strong></dt>
  <dd><%= @monthly_loan.borrow %></dd>
  <dt><strong><%= model_class.human_attribute_name(:lend_total) %>:</strong></dt>
  <dd><%= @monthly_loan.lend_total %></dd>
  <dt><strong><%= model_class.human_attribute_name(:borrow_total) %>:</strong></dt>
  <dd><%= @monthly_loan.borrow_total %></dd>
  <dt><strong><%= model_class.human_attribute_name(:is_actual) %>:</strong></dt>
  <dd><%= @monthly_loan.is_actual %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              monthly_loans_path, :class => 'btn btn-default'  %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_monthly_loan_path(@monthly_loan), :class => 'btn btn-default' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              monthly_loan_path(@monthly_loan),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
