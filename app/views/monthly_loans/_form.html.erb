<%= simple_form_for @monthly_loan, :html => { :class => 'well form-horizontal' } do |f| %>
  <%= f.input :occur_year_month %>
  <%= f.input :lend %>
  <%= f.input :borrow %>
  <%= f.input :lend_total %>
  <%= f.input :borrow_total %>
  <%= f.input :is_actual %>
  
  <%= f.button :submit, :class => 'btn-primary' %>
  <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
                monthly_loans_path, :class => 'btn btn-default' %>
<% end %>
