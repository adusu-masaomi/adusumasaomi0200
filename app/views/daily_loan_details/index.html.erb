<%- model_class = DailyLoanDetail -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.pluralize.titleize %></h1>
  <!-- kaminari用追加箇所開始 -->
  <%= page_entries_info @daily_loan_details %>
  <!-- kaminari用追加箇所終了 -->
  
  <%= search_form_for @q do |f| %>
    <%= f.label :occurred_on, '発生日' %>
    <%= f.text_field :occurred_on_eq, :value=> (f.object.occurred_on.strftime("%Y/%m/%d") if f.object.occurred_on), 
      class:"input-append date datepicker", include_blank: true , size: "12", id: 'payment_on'   %>
  
    <div>
        <%= f.submit '検索(集計)', :class => 'btn btn-teal50_rsd' %>
        <%= link_to t('.new', :default => t("helpers.links.new")),
            new_daily_loan_detail_path,
            :class => 'btn btn-primary' %>  </div>
  <% end %>
  
</div>
<table class="table table-striped">
  <thead>
    <tr>
      <th><%= model_class.human_attribute_name(:id) %></th>
      <th><%= model_class.human_attribute_name(:table_type_id) %></th>
      <th><%= model_class.human_attribute_name(:table_id) %></th>
      <th><%= model_class.human_attribute_name(:lend_borrow_id) %></th>
      <th><%= model_class.human_attribute_name(:occurred_on) %></th>
      <th><%= model_class.human_attribute_name(:summary) %></th>
      <th><%= model_class.human_attribute_name(:amount) %></th>
      <th><%= model_class.human_attribute_name(:source_id) %></th>
      <th><%= model_class.human_attribute_name(:created_at) %></th>
      <th><%=t '.actions', :default => t("helpers.actions") %></th>
    </tr>
  </thead>
  <tbody>
    <% @daily_loan_details.each do |daily_loan_detail| %>
      <tr>
        <td><%= link_to daily_loan_detail.id, daily_loan_detail_path(daily_loan_detail) %></td>
        <td><%= daily_loan_detail.table_type_id %></td>
        <td><%= daily_loan_detail.table_id %></td>
        <td><%= daily_loan_detail.lend_borrow_id %></td>
        <td><%= daily_loan_detail.occurred_on %></td>
        <td><%= daily_loan_detail.summary %></td>
        <td><%= daily_loan_detail.amount %></td>
        <td><%= daily_loan_detail.source_id %></td>
        <td><%=l daily_loan_detail.created_at %></td>
        <td>
          <%= link_to t('.edit', :default => t("helpers.links.edit")),
                      edit_daily_loan_detail_path(daily_loan_detail), :class => 'btn btn-default btn-xs' %>
          <%= link_to t('.destroy', :default => t("helpers.links.destroy")),
                      daily_loan_detail_path(daily_loan_detail),
                      :method => :delete,
                      :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
                      :class => 'btn btn-xs btn-danger' %>
        </td>
      </tr>
    <% end %>
    <!-- kaminari追加箇所開始 -->
    <%= paginate @daily_loan_details %>
    <!-- kaminari追加箇所終了 -->
  </tbody>
</table>

<!-- kaminari追加箇所開始 -->
<%= paginate @daily_loan_details %>
<!-- kaminari追加箇所終了 -->

