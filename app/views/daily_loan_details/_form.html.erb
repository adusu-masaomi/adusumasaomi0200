<%= simple_form_for @daily_loan_detail, :html => { :class => 'well form-horizontal' } do |f| %>
  <%= f.input :table_type_id %>
  <%= f.input :table_id %>
  <%= f.input :lend_borrow_id %>
  <%= f.input :occurred_on %>
  <%= f.input :summary %>
  <%= f.input :amount %>
  <%= f.input :source_id %>

  <%= f.button :submit, :class => 'btn-primary' %>
  <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
                daily_loan_details_path, :class => 'btn btn-default' %>
<% end %>
