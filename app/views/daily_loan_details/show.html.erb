<%- model_class = DailyLoanDetail -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="dl-horizontal">
  <dt><strong><%= model_class.human_attribute_name(:table_type_id) %>:</strong></dt>
  <dd><%= @daily_loan_detail.table_type_id %></dd>
  <dt><strong><%= model_class.human_attribute_name(:table_id) %>:</strong></dt>
  <dd><%= @daily_loan_detail.table_id %></dd>
  <dt><strong><%= model_class.human_attribute_name(:lend_borrow_id) %>:</strong></dt>
  <dd><%= @daily_loan_detail.lend_borrow_id %></dd>
  <dt><strong><%= model_class.human_attribute_name(:occurred_on) %>:</strong></dt>
  <dd><%= @daily_loan_detail.occurred_on %></dd>
  <dt><strong><%= model_class.human_attribute_name(:summary) %>:</strong></dt>
  <dd><%= @daily_loan_detail.summary %></dd>
  <dt><strong><%= model_class.human_attribute_name(:amount) %>:</strong></dt>
  <dd><%= @daily_loan_detail.amount %></dd>
  <dt><strong><%= model_class.human_attribute_name(:source_id) %>:</strong></dt>
  <dd><%= @daily_loan_detail.source_id %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              daily_loan_details_path, :class => 'btn btn-default'  %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_daily_loan_detail_path(@daily_loan_detail), :class => 'btn btn-default' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              daily_loan_detail_path(@daily_loan_detail),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
