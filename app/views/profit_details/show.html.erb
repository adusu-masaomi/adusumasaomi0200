<%- model_class = ProfitDetail -%>
<div class="page-header">
  <h1><%=t '.title', :default => model_class.model_name.human.titleize %></h1>
</div>

<dl class="dl-horizontal">
  <dt><strong><%= model_class.human_attribute_name(:occurred_on) %>:</strong></dt>
  <dd><%= @profit_detail.occurred_on %></dd>
  <dt><strong><%= model_class.human_attribute_name(:cost_id) %>:</strong></dt>
  <dd><%= @profit_detail.cost_id %></dd>
  <dt><strong><%= model_class.human_attribute_name(:table_type_id) %>:</strong></dt>
  <dd><%= @profit_detail.table_type_id %></dd>
  <dt><strong><%= model_class.human_attribute_name(:table_id) %>:</strong></dt>
  <dd><%= @profit_detail.table_id %></dd>
</dl>

<%= link_to t('.back', :default => t("helpers.links.back")),
              profit_details_path, :class => 'btn btn-default'  %>
<%= link_to t('.edit', :default => t("helpers.links.edit")),
              edit_profit_detail_path(@profit_detail), :class => 'btn btn-default' %>
<%= link_to t('.destroy', :default => t("helpers.links.destroy")),
              profit_detail_path(@profit_detail),
              :method => 'delete',
              :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
              :class => 'btn btn-danger' %>
